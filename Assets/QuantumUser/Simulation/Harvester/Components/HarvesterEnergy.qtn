// Assets/QuantumUser/Simulation/Components/HarvesterEnergy.qtn
component HarvesterEnergy
{
    bool UseTimeMode;  // true: HarvestParam is seconds-to-full; false: units-per-second
    FP   HarvestParam; // meaning depends on UseTimeMode
    int  CurrentEnergy; // current harvested energy (integer units)
    int  MaxEnergy;     // maximum allowed energy (integer units)
}
