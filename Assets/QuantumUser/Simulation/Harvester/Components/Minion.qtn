enum MinionState  
{
 GoingToTarget = 0,
  WaitingAtTarget = 1,
  ReturningToSpawn = 2,
  WaitingAtSpawn = 3
}

component Minion {
  FPVector3 SpawnPos;
  FPVector3 TargetPos;
  MinionState State;
  FP StoppingDistance;
  FP WaitTimer;
  FP LifeAfterReturnSeconds; 
}

component MinionWaveSpawner {
  int CurrentWave;
  FP Timer;
  list<EntityRef> SpawnedMinions;
}
